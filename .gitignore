```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.coverage.*
.python-version

# JavaScript/Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled CSS/JS
*.min.js
*.min.css

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
```